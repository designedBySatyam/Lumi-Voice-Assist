ASSISTANT_NAME=Lumi
ASSISTANT_VOICE=female

AI_PROVIDER=openai
SCREEN_READ_MODE=offline
LEARNING_ENABLED=1
LEARNING_FILE=lumi_learning.json
OPENAI_API_KEY=
GEMINI_API_KEY=
USE_AI_INTENT=0

OPENAI_MODEL=gpt-4o-mini
VISION_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-2.0-flash
GEMINI_VISION_MODEL=gemini-2.0-flash

STT_MODE=google
WHISPER_MODEL=gpt-4o-mini-transcribe
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
WAKE_WORD=
PORCUPINE_ACCESS_KEY=
PORCUPINE_KEYWORD=computer
PORCUPINE_MODEL_PATH=
PORCUPINE_SENSITIVITY=0.5
LUMI_HOTKEY=ctrl+space
ALLOW_POWER_ACTIONS=0

VOICE_RATE=180
TYPE_INTERVAL=0.03
MAX_TYPE_CHARS=400

WEATHER_DEFAULT_CITY=Sasaram
WEATHER_UNIT=celsius

ENABLE_UI=1
ASSISTANT_LOG_FILE=assistant.log
