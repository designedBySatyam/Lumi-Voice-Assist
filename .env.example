ASSISTANT_NAME=Lumi
ASSISTANT_VOICE=female

# AI provider: openai or gemini
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
VISION_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_VISION_MODEL=gemini-2.0-flash

# Speech-to-text: google (free) or whisper (requires OPENAI_API_KEY)
STT_MODE=google
WHISPER_MODEL=gpt-4o-mini-transcribe

# Use AI to parse intent (slower but smarter). 0 = local rules only
USE_AI_INTENT=0

# Screen reading: auto | cloud | offline
SCREEN_READ_MODE=auto
# Path to tesseract.exe for offline OCR (leave blank to skip)
TESSERACT_CMD=

# Wake word (blank = no wake word required)
WAKE_WORD=

# Power actions are disabled by default for safety
ALLOW_POWER_ACTIONS=0

# Self-learning from corrections
LEARNING_ENABLED=1
LEARNING_FILE=lumi_learning.json

# TTS voice speed (words per minute)
VOICE_RATE=180

# Auto-type settings
TYPE_INTERVAL=0.03
MAX_TYPE_CHARS=400

# Weather (city name used when none is spoken)
WEATHER_DEFAULT_CITY=
# celsius or fahrenheit
WEATHER_UNIT=celsius

# News headlines (1-5)
NEWS_RESULTS=3

# Screenshot save directory (blank = ~/Pictures)
SCREENSHOT_DIR=

# UI enabled (set 0 for headless / terminal-only)
ENABLE_UI=1

# Log file path
ASSISTANT_LOG_FILE=assistant.log